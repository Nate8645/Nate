# UltraLaunch AI SaaS configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=UltraLaunch AI

# Required before production. Generate: openssl rand -hex 32
SESSION_SECRET=replace_with_64_hex_chars

# SQLite database location. Keep data/ out of git.
DATABASE_PATH=data/ultralaunch.sqlite

# Optional: comma-separated admin emails. The first registered user is admin by default.
ADMIN_EMAILS=founder@example.com

# Optional LLM provider. If absent, the app uses the built-in Launch Intelligence Engine.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Stripe test/live keys. Use test mode first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PILOT=

# Optional customer portal return override; defaults to APP_URL/billing
STRIPE_PORTAL_RETURN_URL=

# Mail is intentionally not hard-coded in the MVP. Export tickets from Admin or connect your ESP.
SUPPORT_EMAIL=support@example.com
